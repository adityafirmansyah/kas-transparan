# kas-transparan Environment Configuration

# Database
DATABASE_URL=sqlite:///./kas_transparan.db
# For PostgreSQL:
# DATABASE_URL=postgresql://kas:kas_dev_password@localhost:5432/kas_transparan

# Security & Auth
SECRET_KEY=dev_secret_change_me_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Auto-seed on startup (seeds demo komunitas, admin/ketua accounts, iuran types, warga if DB is empty)
# Set to false in production to disable automatic demo seeding.
AUTO_SEED=true

# Frontend
VITE_API_BASE_URL=http://localhost:8000

# WhatsApp Notification Gateway (optional)
# Point this at any HTTP gateway that accepts POST {"to": "<msisdn>", "message": "<text>"}
# with an X-API-Key header. Leave WHATSAPP_ENABLED=false to disable notifications entirely.
WHATSAPP_ENABLED=false
WHATSAPP_GATEWAY_URL=
WHATSAPP_API_KEY=
